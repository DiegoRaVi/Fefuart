{
  "name": "fefuart-spa-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "serve:legacy:e2e": "node ./scripts/serve-legacy-e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:canary": "playwright test e2e/smoke.legacy-rollout.spec.ts e2e/smoke.auth-cart-liveart.spec.ts e2e/smoke.cart-orders.spec.ts",
    "test:e2e:validation": "playwright test e2e/smoke.validation-feedback.spec.ts",
    "test:e2e:extended": "playwright test e2e/smoke.backoffice-notifications.spec.ts e2e/smoke.media.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
