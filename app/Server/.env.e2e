# Entorno de los E2E (Fase 7).
#
# Laravel carga este fichero en lugar de `.env` cuando arranca con
# APP_ENV=e2e, que es como lo levanta Playwright.
#
# **Va versionado a proposito, y por eso no lleva ninguna clave real.** Los
# recorridos son offline: no se pulsa «Pagar», asi que nadie llama a la API
# de Stripe y bastan claves con la forma correcta. El secreto del webhook si
# se usa —Playwright calcula el HMAC con este mismo valor para entregar un
# aviso firmado sin salir de la maquina—, y por eso tiene que ser conocido.
#
# Si algun dia hiciera falta una clave de verdad aqui, este fichero deja de
# poder estar versionado.

APP_NAME=Fefuart
APP_ENV=e2e
APP_KEY=base64:O1SpzxZ+DvwB0nD4Ti4NP1/x8cv5ztzB+Lxx0d6RYlE=
# Con trazas: si un recorrido falla, el volcado dice por que. No hay nada
# sensible que exponer en una base de usar y tirar.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Barato: los recorridos crean cuentas y el coste de hashear se nota.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de usar y tirar. `migrate:fresh --seed` la vacia antes de cada tanda,
# asi que NO puede apuntar a `fefuart`: alli viven los datos con los que se
# prueba a mano.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fefuart_e2e
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `sync` y no `database`: sin worker vivo, un aviso encolado no llega nunca
# a Mailpit y la asercion sobre el correo se quedaria esperando. Aqui el
# envio ocurre dentro de la propia peticion.
QUEUE_CONNECTION=sync

CACHE_STORE=array

# Mismo Mailpit que en desarrollo: los recorridos leen la bandeja por su API
# para sacar el enlace de verificacion.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fefuart.local"
MAIL_FROM_NAME="Fefuart"

VITE_APP_NAME="${APP_NAME}"

# D2 — sin el origen declarado no arranca la sesion, y el login falla con un
# error que no dice por que.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Con la forma que espera el SDK y sin valor real. Ningun recorrido llama a
# la pasarela; el secreto del webhook si lo comparte Playwright para firmar.
STRIPE_KEY=pk_test_e2e
STRIPE_SECRET=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_e2e_secreto_conocido
